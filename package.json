{
  "name": "playwright-agentic-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript agentic test automation framework for UI and API testing with Page Object Model, fixtures, services, codebase knowledge, and local agent skills",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "lint": "node ./scripts/checkNamingConventions.mjs && eslint .",
    "lint:fix": "node ./scripts/checkNamingConventions.mjs && eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check:naming": "node ./scripts/checkNamingConventions.mjs",
    "knowledge:build": "node ./scripts/buildKnowledge.mjs",
    "knowledge:validate": "node ./scripts/validateKnowledge.mjs",
    "knowledge:check": "node ./scripts/buildKnowledge.mjs --check && node ./scripts/validateKnowledge.mjs",
    "knowledge:query": "node ./scripts/queryKnowledge.mjs",
    "quality:check": "node ./scripts/checkNamingConventions.mjs && node ./scripts/buildKnowledge.mjs --check && node ./scripts/validateKnowledge.mjs && eslint . && tsc --noEmit && prettier . --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "js-yaml": "^4.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0"
  }
}
