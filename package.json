{
  "name": "playwright-agentic-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript agentic test automation framework for UI and API testing with Page Object Model, fixtures, services, codebase knowledge, and local agent skills",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "lint": "node ./scripts/checkNamingConventions.mjs && eslint .",
    "lint:fix": "node ./scripts/checkNamingConventions.mjs && eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check:naming": "node ./scripts/checkNamingConventions.mjs",
    "knowledge:build": "node ./scripts/buildKnowledge.mjs",
    "knowledge:validate": "node ./scripts/validateKnowledge.mjs",
    "knowledge:check": "node ./scripts/buildKnowledge.mjs --check && node ./scripts/validateKnowledge.mjs",
    "knowledge:query": "node ./scripts/queryKnowledge.mjs",
    "knowledge:impact": "node ./scripts/knowledge/impactReport.mjs",
    "knowledge:relationships": "node ./scripts/knowledge/validateRelationships.mjs",
    "knowledge:relationships:sync": "node ./scripts/knowledge/syncRelationships.mjs",
    "knowledge:product:propose": "node ./scripts/knowledge/proposeProductKnowledge.mjs",
    "knowledge:product:validate": "node ./scripts/knowledge/validateProductDrafts.mjs",
    "knowledge:product:promote": "node ./scripts/knowledge/promoteProductKnowledge.mjs",
    "knowledge:manual:propose": "node ./scripts/knowledge/proposeRequirementKnowledge.mjs --stage=manual",
    "knowledge:automated:propose": "node ./scripts/knowledge/proposeRequirementKnowledge.mjs --stage=automated",
    "knowledge:manual:promote": "node ./scripts/knowledge/promoteManualKnowledge.mjs",
    "knowledge:inventory": "node ./scripts/knowledge/extractTestInventory.mjs",
    "knowledge:propose": "node ./scripts/knowledge/proposeKnowledge.mjs",
    "knowledge:verify-all": "node ./scripts/knowledge/verifyKnowledge.mjs",
    "knowledge:promote": "node ./scripts/knowledge/promoteKnowledge.mjs",
    "knowledge:trace": "node ./scripts/knowledge/traceKnowledge.mjs",
    "knowledge:eval": "node ./scripts/knowledge/evaluateAnswers.mjs",
    "knowledge:verify": "node ./scripts/knowledge/verifyKnowledge.mjs",
    "agent:doctor": "node ./scripts/agentDoctor.mjs",
    "agent:demo": "node ./scripts/agentDemo.mjs",
    "qa:guardrails": "node ./scripts/qaGuardrails.mjs",
    "qa:eval": "node ./scripts/qaEval.mjs",
    "qa:coverage": "node ./scripts/qaCoverage.mjs",
    "qa:impact": "node ./scripts/qaImpact.mjs",
    "qa:validate-result": "node ./scripts/qaResult.mjs",
    "qa:review": "node ./scripts/qaReview.mjs",
    "qa:demo": "node ./scripts/qaDemo.mjs",
    "qa:runtime-demo": "node ./scripts/qaRuntimeDemo.mjs",
    "quality:check": "node ./scripts/checkNamingConventions.mjs && node ./scripts/buildKnowledge.mjs --check && npm run knowledge:validate && node ./scripts/qaGuardrails.mjs && eslint . && tsc --noEmit && prettier . --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "js-yaml": "^4.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0"
  }
}
