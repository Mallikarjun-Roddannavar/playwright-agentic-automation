{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["ui/pages/*"],
      "@api/*": ["api/*"],
      "@utils/*": ["utils/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": [
    "api/**/*.ts",
    "ui/**/*.ts",
    "utils/**/*.ts",
    "scripts/**/*.ts",
    "qa-evals/runtime/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["app"]
}
